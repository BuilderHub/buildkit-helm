{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["daemons"],
  "properties": {
    "daemons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
          "variant": { "type": "string", "enum": ["buildkit", "hive"] },
          "mode": { "type": "string", "enum": ["pod", "daemon", "statefulset"] },
          "arch": { "type": "string", "enum": ["", "amd64", "arm64"] }
        }
      }
    }
  }
}
